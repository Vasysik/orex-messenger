<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Иконка берётся из реального launcher asset,
         затем Flutter продолжает тот же бренд-блок со слоганом и версией. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/orex_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/orex_launch_icon_background</item>
        <item name="android:navigationBarColor">@color/orex_launch_background</item>
        <item name="android:statusBarColor">@color/orex_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/orex_launch_background</item>
        <item name="android:navigationBarColor">@color/orex_launch_background</item>
        <item name="android:statusBarColor">@color/orex_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
