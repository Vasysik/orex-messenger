<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Единый тёмный native bootstrap: без белого кадра до первого Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/orex_launch_background</item>
        <item name="android:statusBarColor">@color/orex_launch_background</item>
    </style>

    <!-- Flutter применяет NormalTheme до первого отрисованного кадра и затем
         оставляет его фоном окна. Сохраняем тот же цвет, чтобы переход native
         splash -> Flutter splash был бесшовным и в светлой системной теме. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/orex_launch_background</item>
        <item name="android:navigationBarColor">@color/orex_launch_background</item>
        <item name="android:statusBarColor">@color/orex_launch_background</item>
    </style>
</resources>
