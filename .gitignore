# =============================================================
# Orex Messenger — .gitignore
#
# Храним исходники Flutter и платформенную конфигурацию:
#   android/
#   windows/
#   web/
#
# iOS, Linux и macOS пока регенерируются при необходимости.
# =============================================================

# --- Сборка и кэш Flutter/Dart ---
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
flutter_*.png
**/generated_plugin_registrant.dart

# --- Android: храним платформенные исходники и конфигурацию ---
android/.gradle/
android/.cxx/
android/local.properties
android/key.properties
android/app/google-services.json
android/**/GeneratedPluginRegistrant.java
**/*.keystore
**/*.jks

# --- Windows: храним runner/native исходники ---
windows/flutter/ephemeral/
windows/**/CMakeFiles/
windows/**/CMakeCache.txt
windows/**/cmake_install.cmake
windows/**/Debug/
windows/**/Profile/
windows/**/Release/
windows/**/x64/
windows/**/x86/
windows/**/arm64/

# --- Web: храним платформенную конфигурацию ---
web/.dart_tool/
web/build/
web/e2ee.worker.dart.js*

# --- Пока не храним эти платформы ---
/ios/
/linux/
/macos/

# --- IDE ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Прочее ---
.DS_Store
*.log
