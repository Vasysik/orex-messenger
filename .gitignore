# =============================================================
# Orex Messenger — .gitignore
#
# Платформенные папки (android/ios/windows/web/linux/macos) и test/
# РЕГЕНЕРИРУЮТСЯ командой `flutter create` и здесь намеренно НЕ хранятся,
# чтобы репозиторий содержал только исходники (lib/, pubspec, assets).
# После клонирования выполните:
#   flutter create --platforms=web,android,windows .
#   flutter pub get
#   dart run flutter_launcher_icons
#   ./tool/setup_web_vodozemac.sh   # wasm для E2EE на web (см. README)
# =============================================================

# --- Генерируемые платформенные папки ---
/android/
/ios/
/linux/
/macos/
/windows/
/web/
/test/

# --- Сборка и кэш Flutter/Dart ---
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
flutter_*.png
**/generated_plugin_registrant.dart

# --- IDE ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Прочее ---
.DS_Store
*.log
EOF
echo "gitignore created"