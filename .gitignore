# =============================================================
# Orex Messenger — .gitignore
#
# Храним исходники (lib/, pubspec, assets) и НАТИВНУЮ конфигурацию android/
# (пермишены звонков, minSdk, иконки и т.п. — иначе они теряются при каждом
# `flutter create`). Остальные платформенные папки регенерируются:
#   flutter create --platforms=web,windows .
#   flutter pub get
#   dart run flutter_launcher_icons
#   ./tool/setup_web_vodozemac.sh   # wasm для E2EE на web (см. README)
# =============================================================

# --- Сборка и кэш Flutter/Dart ---
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
flutter_*.png
**/generated_plugin_registrant.dart

# --- android/: храним, но без генерируемых/машинно-зависимых частей ---
android/.gradle/
android/.cxx/
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java
**/*.keystore
**/*.jks

# --- Остальные платформы регенерируются flutter create ---
/ios/
/linux/
/macos/
/windows/
/web/
/test/

# --- IDE ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Прочее ---
.DS_Store
*.log
